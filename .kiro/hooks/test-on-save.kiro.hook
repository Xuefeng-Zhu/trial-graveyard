{
  "enabled": true,
  "name": "Test on save",
  "description": "Run the related vitest tests when source files change and fix failures.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was edited. Find the vitest tests related to the changed file (colocated *.test.ts or *.test.tsx, or the tests for the module it belongs to) and run them with 'npx vitest run <test files>'. If any fail, diagnose and fix the cause. Prefer fixing the code over weakening the test. Report what you ran."
  }
}
